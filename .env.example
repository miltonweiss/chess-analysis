# OpenAI API key (server-side only — never expose to the browser)
OPENAI_API_KEY=

# Model selection (default: gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# Reasoning effort for Responses API (low | medium | high)
OPENAI_REASONING_EFFORT=medium

# Provider: openai | mock (mock is for dev/tests only)
AI_PROVIDER=openai

# Request timeout in milliseconds (default: 60000)
AI_REQUEST_TIMEOUT_MS=60000

# Rate limit per IP per minute (default: 20)
AI_RATE_LIMIT_PER_MINUTE=20
